<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.fooddyes</groupId>
  <artifactId>fooddyes</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>FoodDyes</name>
  <description>Red 40, Yellow 5 and Blue 1 as edible dyes for Paper 26.3. Powders and sodas, at the cost of a heart per bite.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Target: Paper 26.3 build 244 API. Uses only long-standing Bukkit/Paper
         API, so it also runs on any other 26.3 build. -->
    <paper.version>26.3.build.244-stable</paper.version>
    <paper.api-version>26.3</paper.api-version>
    <!-- pack.mcmeta for the advancement datapack bundled in the jar (resources
         are filtered, so pack/pack.mcmeta is just this property). 26.3 uses the
         [min, max] array form; the 1.21.8 profile below uses single numbers. -->
    <datapack.packmeta>{"pack":{"description":"FoodDyes advancements: Artificially Flavoured.","max_format":[121,0],"min_format":[121,0]}}</datapack.packmeta>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <!-- Test variant compiled against Paper 1.21.8 for live bot tests.
       Build with: mvn -Ptest1218 package -->
  <profiles>
    <profile>
      <id>test1218</id>
      <properties>
        <paper.version>1.21.8-R0.1-SNAPSHOT</paper.version>
        <paper.api-version>1.21</paper.api-version>
        <datapack.packmeta>{"pack":{"pack_format":81,"description":"FoodDyes advancements: Artificially Flavoured."}}</datapack.packmeta>
      </properties>
    </profile>
  </profiles>

  <build>
    <finalName>FoodDyes-1.0.0</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
      </plugin>
    </plugins>
  </build>
</project>
